<?xml version="1.0" encoding="UTF-8"?>
<!--
  GeoCCMM Core: DSpace item metadata (DIM) to DataCite Metadata Schema 4.6.
  Model: https://w3id.org/geoccmm/core/1.0

  Generated by the GeoCCMM tools from the GeoCCMM model, its
  vocabularies and the repository settings. Replace its placeholders as dspace/README.md says.

  DSpace's DataCiteConnector runs this stylesheet and then adds the DOI as the
  <identifier> element, so the stylesheet leaves the identifier out.
  Items without GeoCCMM fields get a plain record built from their Dublin Core.
-->
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:dim="http://www.dspace.org/xmlns/dspace/dim"
    xmlns="http://datacite.org/schema/kernel-4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    exclude-result-prefixes="dim">

  <xsl:output method="xml" indent="yes" encoding="UTF-8"/>

  <!-- DSpace's DOI registration passes a whole dim:dim document; its Signposting endpoint
       passes the dim:field elements without their dim:dim. Both work. -->
  <xsl:variable name="fields" select="/dim:dim/dim:field | /dim:field"/>
  <xsl:variable name="geo" select="boolean($fields[@mdschema='geoccmm'])"/>
  <!-- Metadata languages GeoCCMM accepts: bul ces dan deu ell eng est fin fra gle hrv hun ita lav lit mlt nld pol por ron slk slv spa swe -->
  <xsl:variable name="metadataLanguage">
    <xsl:choose>
      <xsl:when test="$fields[@mdschema='geoccmm' and @element='metadata' and @qualifier='language']">
        <xsl:value-of select="$fields[@mdschema='geoccmm' and @element='metadata' and @qualifier='language'][1]"/>
      </xsl:when>
      <xsl:when test="$geo">ces</xsl:when>
    </xsl:choose>
  </xsl:variable>
  <xsl:variable name="lang">
    <xsl:if test="string($metadataLanguage)">
      <xsl:call-template name="language-tag">
        <xsl:with-param name="value" select="string($metadataLanguage)"/>
      </xsl:call-template>
    </xsl:if>
  </xsl:variable>

  <xsl:template match="/">
    <resource xsi:schemaLocation="http://datacite.org/schema/kernel-4 https://schema.datacite.org/meta/kernel-4.6/metadata.xsd">
      <xsl:variable name="authors" select="$fields[@mdschema='dc' and @element='contributor' and @qualifier='author']"/>
      <creators>
        <xsl:for-each select="$authors">
          <xsl:call-template name="creator"/>
        </xsl:for-each>
        <xsl:if test="not($authors)">
          <creator><creatorName>(:unav)</creatorName></creator>
        </xsl:if>
      </creators>

      <titles>
        <xsl:for-each select="$fields[@mdschema='dc' and @element='title' and not(string(@qualifier))]">
          <title>
            <xsl:call-template name="lang"/>
            <xsl:value-of select="normalize-space(.)"/>
          </title>
        </xsl:for-each>
      </titles>

      <publisher>Your institution</publisher>

      <!-- GeoCCMM items always have dc.date.issued. Other items fall back to the day
           DSpace made them available, or installed them. -->
      <publicationYear>
        <xsl:choose>
          <xsl:when test="$fields[@mdschema='dc' and @element='date' and @qualifier='issued']">
            <xsl:value-of select="substring($fields[@mdschema='dc' and @element='date' and @qualifier='issued'][1], 1, 4)"/>
          </xsl:when>
          <xsl:when test="$fields[@mdschema='dc' and @element='date' and @qualifier='available']">
            <xsl:value-of select="substring($fields[@mdschema='dc' and @element='date' and @qualifier='available'][1], 1, 4)"/>
          </xsl:when>
          <xsl:otherwise>
            <xsl:value-of select="substring($fields[@mdschema='dc' and @element='date' and @qualifier='accessioned'][1], 1, 4)"/>
          </xsl:otherwise>
        </xsl:choose>
      </publicationYear>

      <xsl:variable name="type" select="$fields[@mdschema='dc' and @element='type' and not(string(@qualifier))][1]"/>
      <xsl:choose>
        <xsl:when test="$geo">
          <resourceType resourceTypeGeneral="Dataset">
            <xsl:value-of select="$type"/>
            <xsl:if test="not($type)">Dataset</xsl:if>
          </resourceType>
        </xsl:when>
        <xsl:otherwise>
          <resourceType resourceTypeGeneral="Other"><xsl:value-of select="$type"/></resourceType>
        </xsl:otherwise>
      </xsl:choose>

      <xsl:variable name="ford" select="$fields[@mdschema='geoccmm' and @element='ford']"/>
      <xsl:variable name="themes" select="$fields[@mdschema='geoccmm' and @element='theme']"/>
      <xsl:variable name="vocabularyKeywords" select="$fields[@mdschema='geoccmm' and @element='keyword']"/>
      <xsl:variable name="keywords" select="$fields[@mdschema='dc' and @element='subject' and not(string(@qualifier))]"/>
      <xsl:if test="$ford or $themes or $vocabularyKeywords or $keywords">
        <subjects>
          <xsl:for-each select="$ford">
            <subject subjectScheme="OECD FORD Subject Category (Frascati)" schemeURI="https://vocabs.ccmm.cz/registry/codelist/SubjectCategory/" valueURI="{.}" classificationCode="{substring(., string-length(.) - 4)}" xml:lang="en">
              <xsl:call-template name="ford-label"><xsl:with-param name="value" select="string(.)"/></xsl:call-template>
            </subject>
          </xsl:for-each>
          <xsl:for-each select="$themes">
            <subject subjectScheme="GEMET - INSPIRE themes, version 1.0" schemeURI="http://www.eionet.europa.eu/gemet/inspire_themes" valueURI="{.}" xml:lang="en">
              <xsl:call-template name="theme-label"><xsl:with-param name="value" select="string(.)"/></xsl:call-template>
            </subject>
          </xsl:for-each>
          <xsl:for-each select="$vocabularyKeywords">
            <xsl:variable name="termIri"><xsl:call-template name="part"><xsl:with-param name="index" select="2"/></xsl:call-template></xsl:variable>
            <xsl:variable name="vocabulary"><xsl:call-template name="part"><xsl:with-param name="index" select="3"/></xsl:call-template></xsl:variable>
            <xsl:variable name="vocabularyIri"><xsl:call-template name="part"><xsl:with-param name="index" select="4"/></xsl:call-template></xsl:variable>
            <subject subjectScheme="{$vocabulary}" schemeURI="{$vocabularyIri}">
              <xsl:if test="string($termIri)">
                <xsl:attribute name="valueURI"><xsl:value-of select="$termIri"/></xsl:attribute>
              </xsl:if>
              <xsl:call-template name="lang"/>
              <xsl:call-template name="part"><xsl:with-param name="index" select="1"/></xsl:call-template>
            </subject>
          </xsl:for-each>
          <xsl:for-each select="$keywords">
            <subject>
              <xsl:call-template name="lang"/>
              <xsl:value-of select="normalize-space(.)"/>
            </subject>
          </xsl:for-each>
        </subjects>
      </xsl:if>

      <xsl:variable name="created" select="$fields[@mdschema='dc' and @element='date' and @qualifier='created'][1]"/>
      <xsl:variable name="issued" select="$fields[@mdschema='dc' and @element='date' and @qualifier='issued'][1]"/>
      <xsl:variable name="revised" select="$fields[@mdschema='geoccmm' and @element='revised'][1]"/>
      <xsl:variable name="periods" select="$fields[@mdschema='geoccmm' and @element='period']"/>
      <xsl:if test="$created or $issued or $revised or $periods">
        <dates>
          <xsl:if test="$created"><date dateType="Created"><xsl:value-of select="$created"/></date></xsl:if>
          <xsl:if test="$issued"><date dateType="Issued"><xsl:value-of select="$issued"/></date></xsl:if>
          <xsl:if test="$revised"><date dateType="Updated"><xsl:value-of select="$revised"/></date></xsl:if>
          <xsl:for-each select="$periods">
            <date dateType="Coverage"><xsl:value-of select="concat(substring-before(., ';'), '/', substring-after(., ';'))"/></date>
          </xsl:for-each>
        </dates>
      </xsl:if>

      <xsl:variable name="language" select="$fields[@mdschema='dc' and @element='language' and @qualifier='iso'][1]"/>
      <xsl:if test="$language">
        <language>
          <xsl:call-template name="language-tag"><xsl:with-param name="value" select="string($language)"/></xsl:call-template>
        </language>
      </xsl:if>

      <!-- The handle: the first dc.identifier.uri that is not a DOI (plain DSpace keeps DOIs there too). -->
      <xsl:variable name="handle" select="$fields[@mdschema='dc' and @element='identifier' and @qualifier='uri'][not(contains(., 'doi.org/'))][1]"/>
      <xsl:if test="$handle">
        <alternateIdentifiers>
          <alternateIdentifier alternateIdentifierType="URL"><xsl:value-of select="$handle"/></alternateIdentifier>
        </alternateIdentifiers>
      </xsl:if>

      <xsl:variable name="relations" select="$fields[@mdschema='geoccmm' and @element='relation']"/>
      <xsl:variable name="replaces" select="$fields[@mdschema='dc' and @element='relation' and @qualifier='replaces']"/>
      <xsl:variable name="replacedBy" select="$fields[@mdschema='dc' and @element='relation' and @qualifier='isreplacedby']"/>
      <xsl:if test="$relations or $replaces or $replacedBy">
        <relatedIdentifiers>
          <xsl:for-each select="$relations">
            <xsl:call-template name="related">
              <xsl:with-param name="identifier" select="substring-before(., ';')"/>
              <xsl:with-param name="relation" select="substring-after(., ';')"/>
            </xsl:call-template>
          </xsl:for-each>
          <xsl:for-each select="$replaces">
            <xsl:call-template name="related">
              <xsl:with-param name="identifier" select="string(.)"/>
              <xsl:with-param name="relation" select="'IsNewVersionOf'"/>
            </xsl:call-template>
          </xsl:for-each>
          <xsl:for-each select="$replacedBy">
            <xsl:call-template name="related">
              <xsl:with-param name="identifier" select="string(.)"/>
              <xsl:with-param name="relation" select="'IsPreviousVersionOf'"/>
            </xsl:call-template>
          </xsl:for-each>
        </relatedIdentifiers>
      </xsl:if>

      <xsl:variable name="downloads" select="$fields[@mdschema='geoccmm' and @element='distribution']"/>
      <xsl:if test="$downloads">
        <sizes>
          <xsl:for-each select="$downloads">
            <size>
              <xsl:call-template name="part"><xsl:with-param name="index" select="4"/></xsl:call-template>
              <xsl:text> bytes</xsl:text>
            </size>
          </xsl:for-each>
        </sizes>
        <formats>
          <xsl:for-each select="$downloads">
            <xsl:variable name="format"><xsl:call-template name="part"><xsl:with-param name="index" select="2"/></xsl:call-template></xsl:variable>
            <format>
              <xsl:call-template name="file-type-label"><xsl:with-param name="value" select="string($format)"/></xsl:call-template>
            </format>
          </xsl:for-each>
        </formats>
      </xsl:if>

      <xsl:for-each select="$fields[@mdschema='geoccmm' and @element='version'][1]">
        <version><xsl:value-of select="normalize-space(.)"/></version>
      </xsl:for-each>

      <xsl:variable name="licence" select="$fields[@mdschema='dc' and @element='rights' and @qualifier='uri'][1]"/>
      <xsl:variable name="licenceName" select="$fields[@mdschema='dc' and @element='rights' and not(string(@qualifier))][1]"/>
      <xsl:variable name="access" select="$fields[@mdschema='geoccmm' and @element='access'][1]"/>
      <xsl:if test="$licence or $licenceName or $access">
        <rightsList>
          <xsl:if test="$licence or $licenceName">
            <rights>
              <xsl:if test="$licence">
                <xsl:attribute name="rightsURI"><xsl:value-of select="$licence"/></xsl:attribute>
              </xsl:if>
              <xsl:value-of select="$licenceName"/>
              <xsl:if test="not($licenceName)"><xsl:value-of select="$licence"/></xsl:if>
            </rights>
          </xsl:if>
          <xsl:if test="$access">
            <rights rightsURI="{$access}">
              <xsl:call-template name="access-label"><xsl:with-param name="value" select="string($access)"/></xsl:call-template>
            </rights>
          </xsl:if>
        </rightsList>
      </xsl:if>

      <xsl:variable name="abstract" select="$fields[@mdschema='dc' and @element='description' and @qualifier='abstract'][1]"/>
      <xsl:variable name="lineage" select="$fields[@mdschema='geoccmm' and @element='lineage'][1]"/>
      <xsl:if test="$abstract or $lineage">
        <descriptions>
          <xsl:if test="$abstract">
            <description descriptionType="Abstract">
              <xsl:call-template name="lang"/>
              <xsl:value-of select="$abstract"/>
            </description>
          </xsl:if>
          <xsl:if test="$lineage">
            <description descriptionType="Methods">
              <xsl:call-template name="lang"/>
              <xsl:value-of select="$lineage"/>
            </description>
          </xsl:if>
        </descriptions>
      </xsl:if>

      <xsl:variable name="places" select="$fields[@mdschema='dc' and @element='coverage' and @qualifier='spatial']"/>
      <xsl:variable name="boxes" select="$fields[@mdschema='geoccmm' and @element='bbox']"/>
      <xsl:if test="$places or $boxes">
        <geoLocations>
          <xsl:for-each select="$places">
            <geoLocation><geoLocationPlace><xsl:value-of select="normalize-space(.)"/></geoLocationPlace></geoLocation>
          </xsl:for-each>
          <xsl:for-each select="$boxes">
            <geoLocation>
              <geoLocationBox>
                <westBoundLongitude><xsl:call-template name="part"><xsl:with-param name="index" select="1"/></xsl:call-template></westBoundLongitude>
                <eastBoundLongitude><xsl:call-template name="part"><xsl:with-param name="index" select="2"/></xsl:call-template></eastBoundLongitude>
                <southBoundLatitude><xsl:call-template name="part"><xsl:with-param name="index" select="3"/></xsl:call-template></southBoundLatitude>
                <northBoundLatitude><xsl:call-template name="part"><xsl:with-param name="index" select="4"/></xsl:call-template></northBoundLatitude>
              </geoLocationBox>
            </geoLocation>
          </xsl:for-each>
        </geoLocations>
      </xsl:if>

      <xsl:variable name="funding" select="$fields[@mdschema='geoccmm' and @element='funding']"/>
      <xsl:if test="$funding">
        <fundingReferences>
          <xsl:for-each select="$funding">
            <xsl:variable name="funderId"><xsl:call-template name="part"><xsl:with-param name="index" select="2"/></xsl:call-template></xsl:variable>
            <xsl:variable name="number"><xsl:call-template name="part"><xsl:with-param name="index" select="3"/></xsl:call-template></xsl:variable>
            <xsl:variable name="title"><xsl:call-template name="part"><xsl:with-param name="index" select="4"/></xsl:call-template></xsl:variable>
            <xsl:variable name="uri"><xsl:call-template name="part"><xsl:with-param name="index" select="5"/></xsl:call-template></xsl:variable>
            <fundingReference>
              <funderName><xsl:call-template name="part"><xsl:with-param name="index" select="1"/></xsl:call-template></funderName>
              <xsl:if test="starts-with($funderId, 'https://ror.org/')">
                <funderIdentifier funderIdentifierType="ROR" schemeURI="https://ror.org"><xsl:value-of select="$funderId"/></funderIdentifier>
              </xsl:if>
              <xsl:if test="starts-with($funderId, 'https://doi.org/10.13039/')">
                <funderIdentifier funderIdentifierType="Crossref Funder ID"><xsl:value-of select="$funderId"/></funderIdentifier>
              </xsl:if>
              <xsl:if test="string($number)">
                <awardNumber>
                  <xsl:if test="string($uri)">
                    <xsl:attribute name="awardURI"><xsl:value-of select="$uri"/></xsl:attribute>
                  </xsl:if>
                  <xsl:value-of select="$number"/>
                </awardNumber>
              </xsl:if>
              <xsl:if test="string($title)"><awardTitle><xsl:value-of select="$title"/></awardTitle></xsl:if>
            </fundingReference>
          </xsl:for-each>
        </fundingReferences>
      </xsl:if>
    </resource>
  </xsl:template>

  <!-- One creator. The current node is a dc.contributor.author value. Its optional
       geoccmm.creator row is the one whose name matches when spaces are ignored. -->
  <xsl:template name="creator">
    <xsl:variable name="key" select="translate(., ' &#9;&#10;&#13;', '')"/>
    <xsl:variable name="row" select="$fields[@mdschema='geoccmm' and @element='creator'][translate(substring-before(., ';'), ' &#9;&#10;&#13;', '') = $key][1]"/>
    <xsl:variable name="identifier"><xsl:call-template name="part"><xsl:with-param name="value" select="string($row)"/><xsl:with-param name="index" select="2"/></xsl:call-template></xsl:variable>
    <xsl:variable name="affiliation"><xsl:call-template name="part"><xsl:with-param name="value" select="string($row)"/><xsl:with-param name="index" select="3"/></xsl:call-template></xsl:variable>
    <xsl:variable name="affiliationId"><xsl:call-template name="part"><xsl:with-param name="value" select="string($row)"/><xsl:with-param name="index" select="4"/></xsl:call-template></xsl:variable>
    <xsl:variable name="kind">
      <xsl:choose>
        <xsl:when test="starts-with($identifier, 'https://orcid.org/')">Personal</xsl:when>
        <xsl:when test="starts-with($identifier, 'https://ror.org/')">Organizational</xsl:when>
        <xsl:when test="contains(., ',')">Personal</xsl:when>
        <xsl:otherwise>Organizational</xsl:otherwise>
      </xsl:choose>
    </xsl:variable>
    <creator>
      <xsl:choose>
        <xsl:when test="$kind = 'Personal' and contains(., ',')">
          <creatorName nameType="Personal">
            <xsl:value-of select="concat(normalize-space(substring-before(., ',')), ', ', normalize-space(substring-after(., ',')))"/>
          </creatorName>
          <givenName><xsl:value-of select="normalize-space(substring-after(., ','))"/></givenName>
          <familyName><xsl:value-of select="normalize-space(substring-before(., ','))"/></familyName>
        </xsl:when>
        <xsl:otherwise>
          <creatorName nameType="{$kind}"><xsl:value-of select="normalize-space(.)"/></creatorName>
        </xsl:otherwise>
      </xsl:choose>
      <xsl:if test="starts-with($identifier, 'https://orcid.org/')">
        <nameIdentifier nameIdentifierScheme="ORCID" schemeURI="https://orcid.org"><xsl:value-of select="$identifier"/></nameIdentifier>
      </xsl:if>
      <xsl:if test="starts-with($identifier, 'https://ror.org/')">
        <nameIdentifier nameIdentifierScheme="ROR" schemeURI="https://ror.org"><xsl:value-of select="$identifier"/></nameIdentifier>
      </xsl:if>
      <xsl:if test="string($affiliation)">
        <affiliation>
          <xsl:if test="string($affiliationId)">
            <xsl:attribute name="affiliationIdentifier"><xsl:value-of select="$affiliationId"/></xsl:attribute>
            <xsl:attribute name="affiliationIdentifierScheme">ROR</xsl:attribute>
            <xsl:attribute name="schemeURI">https://ror.org</xsl:attribute>
          </xsl:if>
          <xsl:value-of select="normalize-space($affiliation)"/>
        </affiliation>
      </xsl:if>
    </creator>
  </xsl:template>

  <!-- A related identifier; DOIs and handles are written without their resolver. -->
  <xsl:template name="related">
    <xsl:param name="identifier"/>
    <xsl:param name="relation"/>
    <xsl:choose>
      <xsl:when test="starts-with($identifier, 'https://doi.org/10.') or starts-with($identifier, 'http://doi.org/10.') or starts-with($identifier, 'https://dx.doi.org/10.') or starts-with($identifier, 'http://dx.doi.org/10.')">
        <relatedIdentifier relatedIdentifierType="DOI" relationType="{$relation}"><xsl:value-of select="substring-after($identifier, 'doi.org/')"/></relatedIdentifier>
      </xsl:when>
      <xsl:when test="starts-with($identifier, 'https://hdl.handle.net/') or starts-with($identifier, 'http://hdl.handle.net/')">
        <relatedIdentifier relatedIdentifierType="Handle" relationType="{$relation}"><xsl:value-of select="substring-after($identifier, 'hdl.handle.net/')"/></relatedIdentifier>
      </xsl:when>
      <xsl:when test="starts-with($identifier, 'urn:')">
        <relatedIdentifier relatedIdentifierType="URN" relationType="{$relation}"><xsl:value-of select="$identifier"/></relatedIdentifier>
      </xsl:when>
      <xsl:otherwise>
        <relatedIdentifier relatedIdentifierType="URL" relationType="{$relation}"><xsl:value-of select="$identifier"/></relatedIdentifier>
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <!-- Part number $index (from 1) of a grouped GeoCCMM value "a;b;c". -->
  <xsl:template name="part">
    <xsl:param name="value" select="string(.)"/>
    <xsl:param name="index"/>
    <xsl:choose>
      <xsl:when test="$index &gt; 1">
        <xsl:call-template name="part">
          <xsl:with-param name="value" select="substring-after($value, ';')"/>
          <xsl:with-param name="index" select="$index - 1"/>
        </xsl:call-template>
      </xsl:when>
      <xsl:when test="contains($value, ';')"><xsl:value-of select="substring-before($value, ';')"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="$value"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template name="lang">
    <xsl:if test="string($lang)">
      <xsl:attribute name="xml:lang"><xsl:value-of select="$lang"/></xsl:attribute>
    </xsl:if>
  </xsl:template>

  <xsl:template name="theme-label">
    <xsl:param name="value"/>
    <xsl:choose>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/ac'">Atmospheric conditions</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/ad'">Addresses</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/af'">Agricultural and aquaculture facilities</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/am'">Area management/restriction/regulation zones and reporting units</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/au'">Administrative units</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/br'">Bio-geographical regions</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/bu'">Buildings</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/cp'">Cadastral parcels</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/ef'">Environmental monitoring facilities</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/el'">Elevation</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/er'">Energy resources</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/ge'">Geology</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/gg'">Geographical grid systems</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/gn'">Geographical names</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/hb'">Habitats and biotopes</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/hh'">Human health and safety</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/hy'">Hydrography</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/lc'">Land cover</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/lu'">Land use</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/mf'">Meteorological geographical features</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/mr'">Mineral resources</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/nz'">Natural risk zones</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/of'">Oceanographic geographical features</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/oi'">Orthoimagery</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/pd'">Population distribution — demography</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/pf'">Production and industrial facilities</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/ps'">Protected sites</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/rs'">Coordinate reference systems</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/sd'">Species distribution</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/so'">Soil</xsl:when>
      <xsl:when test="$value = 'http://inspire.ec.europa.eu/theme/sr'">Sea regions</xsl:when>
